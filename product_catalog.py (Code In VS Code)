# Product Recommendation Tool

from products import products


# Step 2: Explore the product data
print("First few products:")
print(products[:3])
print()


# Step 3: Collect customer preferences
customer_preferences = []

while True:
    preference = input("Input a preference: ").strip().lower()

    if preference:
        customer_preferences.append(preference)

    another = input("Do you want to add another preference? (Y/N): ").strip().upper()

    if another == "N":
        break


# Step 4: Convert customer preferences to a set
# This removes duplicate preferences.
customer_preferences = set(customer_preferences)


# Convert each product's tags to a set
# so that set operations can be used to find matches.
products_with_sets = []

for product in products:
    product_copy = product.copy()
    product_copy["tags"] = set(product["tags"])
    products_with_sets.append(product_copy)


# Step 5: Count matching tags
def count_matches(product_tags, customer_preferences):
    """
    Count how many tags a product has in common
    with the customer's preferences.
    """
    return len(product_tags.intersection(customer_preferences))


# Step 6: Build the recommendation function
def recommend_products(products, customer_preferences):
    recommendations = []

    for product in products:
        matches = count_matches(product["tags"], customer_preferences)

        if matches > 0:
            recommendations.append({
                "name": product["name"],
                "matches": matches
            })

    # Sort products from highest number of matches to lowest
    recommendations.sort(key=lambda product: product["matches"], reverse=True)

    return recommendations


# Get recommendations
recommendations = recommend_products(
    products_with_sets,
    customer_preferences
)


# Print recommendations
print("\nRecommended Products:")

if recommendations:
    for product in recommendations:
        print(f"- {product['name']} ({product['matches']} match(es))")
else:
    print("No products matched your preferences.")


